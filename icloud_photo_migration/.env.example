# ==========================================================================
#  Vorlage. NICHT ausfüllen und committen!
#  In Colab: Werte stattdessen unter "Secrets" (Schlüssel-Symbol links) ablegen.
#  Lokal (Test): Datei nach .env kopieren, ausfüllen -> .env ist gitignored.
#
#  HYBRID-MODUS: KEINE Apple-/iCloud-Zugangsdaten nötig!
#  Der iCloud-Import passiert am iPhone per Kurzbefehl (siehe SHORTCUT.md).
# ==========================================================================

# --- OneDrive / Microsoft Graph (nur wenn USE_ONEDRIVE=true) ---
# Aus dem Azure-App-Registrierungs-Portal (siehe SETUP.md, Schritt 4)
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_TENANT=consumers            # "consumers" = privates Microsoft-Konto

# --- Quellen an/aus ---
USE_GDRIVE=true
USE_ONEDRIVE=true

# --- Pfade ---
GDRIVE_MOUNT=/content/drive/MyDrive
GDRIVE_SUBDIR=Bilder                       # Google-Drive-Quellordner
ONEDRIVE_PATH=Meine Daten/Bilder           # OneDrive-Quellordner
READY_SUBDIR=Fertig_iCloud                 # Ziel für fertige Dateien (in Drive)

# --- Verhalten ---
TEST_MODE=true                 # true = nur TEST_LIMIT Dateien verarbeiten
TEST_LIMIT=100
FALLBACK_DATE=2022-12-01       # wenn kein EXIF-Datum vorhanden
DELETE_STAGE=dry_run           # dry_run | trash | permanent  (siehe SETUP.md)
